# 站点基本信息（构建时写入静态页面）
NEXT_PUBLIC_SITE_NAME=我的数字花园
NEXT_PUBLIC_SITE_DESCRIPTION=记录技术、学习与思考
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_AUTHOR_NAME=你的名字
NEXT_PUBLIC_AUTHOR_BIO=一个持续学习和写作的人
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name
NEXT_PUBLIC_EMAIL=hello@example.com

# 是否在构建结果中包含 frontmatter 里 draft: true 的文章
INCLUDE_DRAFTS=false

# Umami，可留空。Cloud 默认脚本地址是 https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=
NEXT_PUBLIC_UMAMI_HOST_URL=

# Giscus，可留空；在 https://giscus.app 配置后填写
NEXT_PUBLIC_GISCUS_REPO=your-name/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
